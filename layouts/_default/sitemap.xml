{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
  http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
  {{ range .Data.Pages }}
  {{ $date := "" }}
  {{ if .Lastmod }}
    {{ $date = .Lastmod }}
  {{ else if .Date }}
    {{ $date = .Date }}
  {{ else }}
    {{ $date = now }}
  {{ end }}
  {{ if and $date (ne $date.Year 1) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ $date.Format "2006-01-02" }}</lastmod>
    {{ if and .IsPage (eq .Section "blog") }}<changefreq>daily</changefreq>{{ else if and .IsPage (eq .Section "stories") }}<changefreq>weekly</changefreq>{{ else if .IsPage }}<changefreq>weekly</changefreq>{{ else }}<changefreq>daily</changefreq>{{ end }}
    {{ if .IsHome }}<priority>1.0</priority>{{ else if and .IsPage (eq .Section "blog") }}<priority>1.0</priority>{{ else if and .IsPage (eq .Section "stories") }}<priority>0.9</priority>{{ else if eq .Section "schools" }}<priority>0.9</priority>{{ else }}<priority>0.7</priority>{{ end }}
  </url>
  {{ end }}
  {{ end }}
</urlset>
